# Local datasets and expensive feature caches
/data/
/features/

# Experiment outputs: ignore by default, then whitelist compact formal results
/outputs/*
!/outputs/README.md

# Stage 1: sync only aggregate Global-Local GMM/SimiFeat tables
!/outputs/generalization/
/outputs/generalization/*
!/outputs/generalization/summaries/
!/outputs/generalization/summaries/**

# Stage 1 CLIP baselines: keep per-sample files local, sync compact tables
!/outputs/generalization/baselines/
/outputs/generalization/baselines/*
!/outputs/generalization/baselines/summaries/
!/outputs/generalization/baselines/summaries/**

# Stage 2: sync per-seed metrics and aggregate metrics, never future large artifacts
!/outputs/stage2/
/outputs/stage2/**
!/outputs/stage2/**/
!/outputs/stage2/**/runs.csv
!/outputs/stage2/**/summary.csv

# Future Stage-2 baselines: sync compact metrics only
!/outputs/stage2_baselines/
/outputs/stage2_baselines/**
!/outputs/stage2_baselines/**/
!/outputs/stage2_baselines/**/runs.csv
!/outputs/stage2_baselines/**/summary.csv

# Standalone ECE reports across Ours and future Stage-2 baselines
!/outputs/ece/
!/outputs/ece/*.csv

# Clean-label linear-probe reference: sync only its three compact CSV tables
!/outputs/clean_lp/
/outputs/clean_lp/*
!/outputs/clean_lp/dinov2_clean_lp_raw.csv
!/outputs/clean_lp/clean_lp_summary.csv
!/outputs/clean_lp/dinov2_ours_vs_clean_lp.csv

# Validation-only and temporary files
/tests/
/tmp/
/history/
/logs/
/check_feature_dim.py
*.log
nohup.out

# Python and tool caches
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environments and editor state
.venv/
venv/
.idea/
.vscode/
.DS_Store
Thumbs.db
